+      </header>
+
+      <main id="main-content">
+        {/* ---------- HERO ---------- */}
+        <section className="land-hero" aria-labelledby="hero-heading">
+          <div>
+            <p className="section-eyebrow">Yashil o'quv dasturi · AR/VR</p>
+            <h1 id="hero-heading">
+              Tabiatni <em>skanerlang</em>,<br />
+              ekologiyani his qilib o'rganing
