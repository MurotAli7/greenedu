new file mode 100644
index 0000000..98de609
--- /dev/null
+++ b/src/app/forgot-password/page.jsx
@@ -0,0 +1,83 @@
+"use client";
+
+import { useState } from "react";
+import Link from "next/link";
+import { createClient } from "@/lib/supabase/client";
+import AuthHero from "../auth-hero";
+
+export default function ForgotPasswordPage() {
+  const [email, setEmail] = useState("");
+  const [sent, setSent] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+
+  const handleSubmit = async (e) => {
+    e.preventDefault();
+    setError("");
+    if (!email) {
+      setError("Emailingizni kiriting.");
+      return;
+    }
+
+    setLoading(true);
+    try {
+      const supabase = createClient();
+      const { error: resetError } = await supabase.auth.resetPasswordForEmail(email, {
+        redirectTo:
+          typeof window !== "undefined" ? `${window.location.origin}/login` : undefined,
+      });
+      if (resetError) {
+        setError(resetError.message);
+        return;
+      }
+      setSent(true);
+    } catch {
+      setError("Xatolik yuz berdi. Qaytadan urinib ko'ring.");
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="auth-page">
+      <AuthHero />
+      <main id="main-content" className="auth-form-side">
+        <div className="auth-card">
+          <h1>Parolni tiklash</h1>
+          <p className="lead">
+            Emailingizni kiriting — parolni tiklash havolasini yuboramiz.
+          </p>
+
+          {sent ? (
+            <p className="form-ok">
+              Havola yuborildi! Emailingizni tekshiring (spam papkani ham),
+              so'ng havola orqali yangi parol o'rnating.
+            </p>
+          ) : (
+            <form onSubmit={handleSubmit} className="auth-form" noValidate>
+              <div className="field">
+                <label htmlFor="email">Email</label>
+                <input
+                  id="email" type="email" className="input"
+                  placeholder="siz@misol.uz" value={email}
+                  onChange={(e) => setEmail(e.target.value)}
+                  autoComplete="username" autoFocus
+                />
+              </div>
+
+              {error && <p className="form-error">{error}</p>}
+
+              <button type="submit" className="btn btn-primary btn-lg" disabled={loading}>
+                {loading ? "Yuborilmoqda..." : "Havolani yuborish"}
+              </button>
+            </form>
+          )}
+
+          <p className="auth-links">
+            <Link href="/login">← Kirish sahifasiga qaytish</Link>
+          </p>
+        </div>
+      </main>
+    </div>
+  );
+}
diff --git a/src/app/globals.css b/src/app/globals.css
new file mode 100644
index 0000000..31f76e0
--- /dev/null
+++ b/src/app/globals.css
@@ -0,0 +1,1041 @@
+@import "tailwindcss";
+
+/* ============================================================
+   GreenEdu dizayn tizimi
+   Palitra: o'rmon yashili + qog'oz oq + quyosh (XP) + osmon (VR)
+   Imzo element: AR vizör burchak ramkalari (.viewfinder)
+   ============================================================ */
+
+:root {
+  --paper: #f6f8f3;
+  --surface: #ffffff;
+  --ink: #1c2a21;
+  --ink-soft: #51655a;
+  --ink-faint: #8aa094;
+
+  --leaf: #2e7d4f;
+  --leaf-deep: #1e5637;
+  --leaf-bright: #3fa16a;
+  --moss: #e3ede0;
+  --moss-line: #cddcc9;
+
+  --sun: #e8a33d;
+  --sun-soft: #fbf0dc;
+  --sky: #3e7ca6;
+  --sky-soft: #e3eef5;
+  --violet: #7b5ea7;
+  --violet-soft: #ede7f6;
+  --danger: #c2453a;
+  --danger-soft: #fae7e5;
+
+  --radius: 14px;
+  --radius-sm: 9px;
+  --shadow: 0 1px 2px rgba(28, 42, 33, 0.05), 0 8px 24px rgba(28, 42, 33, 0.07);
+  --shadow-lg: 0 4px 12px rgba(28, 42, 33, 0.08), 0 20px 48px rgba(28, 42, 33, 0.14);
+
+  --font-display: var(--font-bricolage), "Bricolage Grotesque", system-ui, sans-serif;
+  --font-body: var(--font-public), "Public Sans", system-ui, sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+html { scroll-behavior: smooth; }
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { animation: none !important; transition: none !important; }
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--font-body);
+  font-size: 15px;
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3, h4 {
+  font-family: var(--font-display);
+  line-height: 1.15;
+  margin: 0;
+  letter-spacing: -0.01em;
+}
+
+a { color: inherit; }
+button { font-family: inherit; }
+
+:focus-visible {
+  outline: 2px solid var(--leaf);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+/* ---------- Imzo element: AR vizör burchaklari ---------- */
+.viewfinder {
+  position: relative;
+}
+.viewfinder::before,
+.viewfinder::after,
+.viewfinder > .vf-b::before,
+.viewfinder > .vf-b::after {
+  content: "";
+  position: absolute;
+  width: 22px;
+  height: 22px;
+  border: 2.5px solid var(--leaf);
+  pointer-events: none;
+}
+.viewfinder::before { top: -8px; left: -8px; border-right: 0; border-bottom: 0; border-top-left-radius: 8px; }
+.viewfinder::after { top: -8px; right: -8px; border-left: 0; border-bottom: 0; border-top-right-radius: 8px; }
+.viewfinder > .vf-b::before { bottom: -8px; left: -8px; border-right: 0; border-top: 0; border-bottom-left-radius: 8px; }
+.viewfinder > .vf-b::after { bottom: -8px; right: -8px; border-left: 0; border-top: 0; border-bottom-right-radius: 8px; }
+.viewfinder-sun::before, .viewfinder-sun::after,
+.viewfinder-sun > .vf-b::before, .viewfinder-sun > .vf-b::after { border-color: var(--sun); }
+.viewfinder-sky::before, .viewfinder-sky::after,
+.viewfinder-sky > .vf-b::before, .viewfinder-sky > .vf-b::after { border-color: var(--sky); }
+.viewfinder-sm::before, .viewfinder-sm::after,
+.viewfinder-sm > .vf-b::before, .viewfinder-sm > .vf-b::after {
+  width: 13px; height: 13px; border-width: 2px;
+}
+.viewfinder-sm::before { top: -5px; left: -5px; }
+.viewfinder-sm::after { top: -5px; right: -5px; }
+.viewfinder-sm > .vf-b::before { bottom: -5px; left: -5px; }
+.viewfinder-sm > .vf-b::after { bottom: -5px; right: -5px; }
+
+/* ---------- Tugmalar ---------- */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 10px 18px;
+  border-radius: 999px;
+  border: 1.5px solid transparent;
+  font-size: 14.5px;
+  font-weight: 600;
+  cursor: pointer;
+  text-decoration: none;
+  transition: background 0.15s, border-color 0.15s, transform 0.08s;
+  white-space: nowrap;
+}
+.btn:active { transform: translateY(1px); }
+.btn:disabled { opacity: 0.55; cursor: not-allowed; }
+.btn-primary { background: var(--leaf); color: #fff; }
+.btn-primary:hover:not(:disabled) { background: var(--leaf-deep); }
+.btn-ghost { background: transparent; color: var(--leaf-deep); border-color: var(--moss-line); }
+.btn-ghost:hover:not(:disabled) { background: var(--moss); }
+.btn-danger { background: var(--danger); color: #fff; }
+.btn-danger:hover:not(:disabled) { background: #a83a30; }
+.btn-sm { padding: 6px 13px; font-size: 13px; }
+.btn-lg { padding: 13px 26px; font-size: 16px; }
+
+.iconbtn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 32px;
+  height: 32px;
+  border-radius: var(--radius-sm);
+  border: 1px solid var(--moss-line);
+  background: var(--surface);
+  color: var(--ink-soft);
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+.iconbtn:hover:not(:disabled) { background: var(--moss); color: var(--ink); }
+.iconbtn:disabled { opacity: 0.5; cursor: not-allowed; }
+.iconbtn.is-danger:hover:not(:disabled) { background: var(--danger-soft); color: var(--danger); border-color: #eec7c3; }
+
+/* ---------- Kartalar / panellar ---------- */
+.card {
+  background: var(--surface);
+  border: 1px solid var(--moss-line);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow);
+}
+.card-pad { padding: 20px; }
+
+.panel-title {
+  font-size: 17px;
+  font-weight: 700;
+}
+.section-eyebrow {
+  display: inline-block;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--leaf);
+  margin-bottom: 10px;
+}
+
+/* ---------- Belgilar (badge/chip) ---------- */
+.chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 3px 11px;
+  border-radius: 999px;
+  font-size: 12.5px;
+  font-weight: 600;
+  line-height: 1.6;
+}
+.chip-green { background: var(--moss); color: var(--leaf-deep); }
+.chip-amber { background: var(--sun-soft); color: #9a6a1c; }
+.chip-gray { background: #edf0ec; color: var(--ink-soft); }
+.chip-sky { background: var(--sky-soft); color: #2b5c7d; }
+.chip-violet { background: var(--violet-soft); color: #5c4585; }
+.chip-red { background: var(--danger-soft); color: var(--danger); }
+.chip-click { border: 0; cursor: pointer; }
+.chip-click:hover { filter: brightness(0.96); }
+
+/* ---------- Formalar ---------- */
+.field { display: flex; flex-direction: column; gap: 6px; }
+.field label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
+.input, .select, .textarea {
+  width: 100%;
+  padding: 10px 14px;
+  border-radius: var(--radius-sm);
+  border: 1.5px solid var(--moss-line);
+  background: var(--surface);
+  color: var(--ink);
+  font-size: 14.5px;
+  font-family: inherit;
+  transition: border-color 0.15s;
+}
+.input:focus, .select:focus, .textarea:focus {
+  outline: none;
+  border-color: var(--leaf);
+}
+.textarea { resize: vertical; min-height: 84px; }
+.form-error {
+  background: var(--danger-soft);
+  color: var(--danger);
+  border-radius: var(--radius-sm);
+  padding: 10px 14px;
+  font-size: 13.5px;
+}
+.form-ok {
+  background: var(--moss);
+  color: var(--leaf-deep);
+  border-radius: var(--radius-sm);
+  padding: 10px 14px;
+  font-size: 13.5px;
+}
+
+/* ---------- Jadval ---------- */
+.tablewrap { overflow-x: auto; }
+.table { width: 100%; border-collapse: collapse; font-size: 14px; }
+.table th {
+  text-align: left;
+  padding: 11px 16px;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+  color: var(--ink-faint);
+  border-bottom: 1px solid var(--moss-line);
+}
+.table td {
+  padding: 13px 16px;
+  border-bottom: 1px solid #eef2ec;
+  vertical-align: middle;
+}
+.table tr:last-child td { border-bottom: 0; }
+.table .empty { text-align: center; color: var(--ink-faint); padding: 30px 16px; }
+
+.cell-user { display: flex; align-items: center; gap: 11px; }
+.avatar {
+  width: 34px; height: 34px;
+  border-radius: 999px;
+  background: var(--moss);
+  color: var(--leaf-deep);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 700;
+  font-size: 14px;
+  flex-shrink: 0;
+}
+.cell-name { font-weight: 600; }
+.cell-sub { font-size: 12.5px; color: var(--ink-faint); }
+
+/* ---------- Progress ---------- */
+.progress {
+  height: 8px;
+  border-radius: 999px;
+  background: var(--moss);
+  overflow: hidden;
+}
+.progress > i {
+  display: block;
+  height: 100%;
+  border-radius: 999px;
+  background: linear-gradient(90deg, var(--leaf-bright), var(--leaf));
+  transition: width 0.4s ease;
+}
+.progress-sun > i { background: linear-gradient(90deg, #f2bd66, var(--sun)); }
+
+/* ---------- App shell (sidebar + kontent) ---------- */
+.shell { display: flex; min-height: 100dvh; }
+.shell-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
+.shell-content { padding: 26px 30px 48px; max-width: 1200px; width: 100%; margin: 0 auto; }
+
+.sidebar {
+  width: 246px;
+  flex-shrink: 0;
+  background: var(--leaf-deep);
+  color: #eaf3ec;
+  display: flex;
+  flex-direction: column;
+  padding: 20px 14px;
+  position: sticky;
+  top: 0;
+  height: 100dvh;
+}
+.sidebar-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 6px 10px 20px;
+  text-decoration: none;
+  color: #fff;
+}
+.brand-mark {
+  width: 34px; height: 34px;
+  border-radius: 10px;
+  background: rgba(255,255,255,0.14);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+.brand-name { font-family: var(--font-display); font-weight: 700; font-size: 17px; line-height: 1.1; }
+.brand-tag { font-size: 11px; opacity: 0.7; letter-spacing: 0.08em; text-transform: uppercase; }
+
+.nav { display: flex; flex-direction: column; gap: 3px; flex: 1; }
+.nav-link {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 10px 12px;
+  border-radius: 10px;
+  color: #cfe2d4;
+  text-decoration: none;
+  font-size: 14px;
+  font-weight: 500;
+  transition: background 0.12s, color 0.12s;
+}
+.nav-link:hover { background: rgba(255,255,255,0.08); color: #fff; }
+.nav-link.is-active { background: rgba(255,255,255,0.14); color: #fff; font-weight: 600; }
+.nav-count {
+  margin-left: auto;
+  background: var(--sun);
+  color: #4a3208;
+  font-size: 11px;
+  font-weight: 700;
+  border-radius: 999px;
+  padding: 1px 7px;
+}
+
+.sidebar-footer {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 10px 2px;
+  border-top: 1px solid rgba(255,255,255,0.12);
+  font-size: 13px;
+}
+.sidebar-footer .avatar { background: rgba(255,255,255,0.16); color: #fff; }
+.sf-name { font-weight: 600; color: #fff; }
+.sf-role { font-size: 11.5px; opacity: 0.65; }
+.sf-logout {
+  margin-left: auto;
+  background: none; border: 0;
+  color: #cfe2d4; cursor: pointer;
+  padding: 6px; border-radius: 8px;
+  display: inline-flex;
+}
+.sf-logout:hover { background: rgba(255,255,255,0.1); color: #fff; }
+
+.topbar {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 14px 30px;
+  background: var(--surface);
+  border-bottom: 1px solid var(--moss-line);
+  position: sticky;
+  top: 0;
+  z-index: 30;
+}
+.topbar-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; }
+.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
+.menu-btn { display: none; }
+
+.sidebar-overlay { display: none; }
+
+@media (max-width: 920px) {
+  .sidebar {
+    position: fixed;
+    left: 0; top: 0;
+    z-index: 60;
+    transform: translateX(-100%);
+    transition: transform 0.22s ease;
+    box-shadow: var(--shadow-lg);
+  }
+  .sidebar.is-open { transform: translateX(0); }
+  .sidebar-overlay {
+    display: block;
+    position: fixed; inset: 0;
+    background: rgba(20, 32, 25, 0.45);
+    z-index: 55;
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity 0.2s;
+  }
+  .sidebar-overlay.is-open { opacity: 1; pointer-events: auto; }
+  .menu-btn { display: inline-flex; }
+  .shell-content { padding: 20px 16px 40px; }
+  .topbar { padding: 12px 16px; }
+}
+
+/* ---------- Sahifa sarlavhasi ---------- */
+.page-head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  margin-bottom: 22px;
+}
+.page-title { font-size: 26px; font-weight: 700; }
+.page-sub { color: var(--ink-soft); margin: 5px 0 0; font-size: 14.5px; }
+
+/* ---------- Statistika kartalari ---------- */
+.stats-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
+  gap: 14px;
+  margin-bottom: 22px;
+}
+.statcard { padding: 18px; }
+.statcard .ic {
+  width: 38px; height: 38px;
+  border-radius: 11px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 12px;
+}
+.ic-green { background: var(--moss); color: var(--leaf-deep); }
+.ic-sun { background: var(--sun-soft); color: #9a6a1c; }
+.ic-sky { background: var(--sky-soft); color: var(--sky); }
+.ic-violet { background: var(--violet-soft); color: var(--violet); }
+.statcard .val { font-family: var(--font-display); font-size: 27px; font-weight: 700; line-height: 1; }
+.statcard .lbl { color: var(--ink-soft); font-size: 13px; margin-top: 6px; }
+
+/* ---------- Modal ---------- */
+.modal-backdrop {
+  position: fixed; inset: 0;
+  background: rgba(20, 32, 25, 0.5);
+  z-index: 90;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 20px;
+  animation: fadeIn 0.14s ease;
+}
+.modal {
+  background: var(--surface);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-lg);
+  width: 100%;
+  max-width: 460px;
+  max-height: 88dvh;
+  overflow-y: auto;
+  animation: popIn 0.16s ease;
+}
+.modal-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 18px 22px 0;
+}
+.modal-title { font-size: 18px; font-weight: 700; }
+.modal-body { padding: 16px 22px; display: flex; flex-direction: column; gap: 14px; }
+.modal-foot {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  padding: 4px 22px 20px;
+}
+@keyframes fadeIn { from { opacity: 0; } }
+@keyframes popIn { from { opacity: 0; transform: scale(0.97) translateY(6px); } }
+
+/* ---------- Yuklanish / bo'sh holat ---------- */
+.state-note {
+  text-align: center;
+  color: var(--ink-faint);
+  padding: 34px 16px;
+  font-size: 14px;
+}
+
+/* ---------- Filtr paneli ---------- */
+.filterbar {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  margin-bottom: 16px;
+}
+.filter-search {
+  flex: 1;
+  min-width: 220px;
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  background: var(--surface);
+  border: 1.5px solid var(--moss-line);
+  border-radius: 999px;
+  padding: 0 16px;
+  color: var(--ink-faint);
+}
+.filter-search input {
+  border: 0; outline: none;
+  padding: 10px 0;
+  flex: 1;
+  font-size: 14.5px;
+  background: transparent;
+  color: var(--ink);
+  font-family: inherit;
+}
+.filter-select {
+  border: 1.5px solid var(--moss-line);
+  border-radius: 999px;
+  background: var(--surface);
+  padding: 0 16px;
+  font-size: 14px;
+  font-family: inherit;
+  color: var(--ink);
+}
+
+/* ---------- Kurs kartalari ---------- */
+.course-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
+  gap: 16px;
+}
+.course-card { display: flex; flex-direction: column; overflow: hidden; }
+.course-thumb {
+  height: 128px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+  color: #fff;
+}
+.thumb-course { background: linear-gradient(135deg, var(--leaf-bright), var(--leaf-deep)); }
+.thumb-ar { background: linear-gradient(135deg, #f0b45c, #cf8a24); }
+.thumb-vr { background: linear-gradient(135deg, #5c9cc4, #2d5f82); }
+.thumb-tag {
+  position: absolute;
+  top: 10px; left: 10px;
+  background: rgba(255,255,255,0.92);
+  color: var(--ink);
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  border-radius: 6px;
+  padding: 2px 8px;
+}
+.course-body { padding: 15px 17px 17px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
+.course-title { font-size: 16px; font-weight: 700; }
+.course-desc { font-size: 13px; color: var(--ink-soft); flex: 1; }
+.course-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  font-size: 12.5px;
+  color: var(--ink-faint);
+}
+
+/* ---------- Bar chart (statistika sahifasi) ---------- */
+.barchart {
+  display: flex;
+  align-items: flex-end;
+  gap: 5px;
+  height: 150px;
+  padding-top: 8px;
+}
+.barchart .bar {
+  flex: 1;
+  background: var(--leaf-bright);
+  border-radius: 4px 4px 0 0;
+  min-height: 2px;
+  position: relative;
+}
+.barchart .bar:hover { background: var(--leaf-deep); }
+.barchart .bar span {
+  position: absolute;
+  bottom: 100%;
+  left: 50%;
+  transform: translateX(-50%);
+  font-size: 10.5px;
+  color: var(--ink-soft);
+  padding-bottom: 3px;
+  white-space: nowrap;
+}
+.barchart-x {
+  display: flex;
+  gap: 5px;
+  font-size: 10px;
+  color: var(--ink-faint);
+  margin-top: 6px;
+}
+.barchart-x span { flex: 1; text-align: center; overflow: hidden; }
+
+/* ---------- Auth sahifalari ---------- */
+.auth-page {
+  min-height: 100dvh;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+}
+.auth-hero {
+  background: var(--leaf-deep);
+  color: #eaf3ec;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  padding: 56px;
+  position: relative;
+  overflow: hidden;
+}
+.auth-hero h2 { color: #fff; font-size: 34px; max-width: 420px; }
+.auth-hero p { max-width: 400px; opacity: 0.85; }
+.auth-form-side {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 40px 24px;
+}
+.auth-card { width: 100%; max-width: 400px; }
+.auth-card h1 { font-size: 25px; margin-bottom: 6px; }
+.auth-card .lead { color: var(--ink-soft); font-size: 14px; margin: 0 0 22px; }
+.auth-form { display: flex; flex-direction: column; gap: 14px; }
+.auth-links { font-size: 13.5px; color: var(--ink-soft); text-align: center; margin-top: 18px; }
+.auth-links a { color: var(--leaf-deep); font-weight: 600; }
+@media (max-width: 860px) {
+  .auth-page { grid-template-columns: 1fr; }
+  .auth-hero { display: none; }
+}
+
+/* ---------- Landing ---------- */
+.land-header {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 18px clamp(20px, 5vw, 64px);
+  max-width: 1220px;
+  margin: 0 auto;
+  width: 100%;
+}
+.land-header nav { margin-left: auto; display: flex; align-items: center; gap: 8px; }
+
+.land-hero {
+  max-width: 1220px;
+  margin: 0 auto;
+  padding: clamp(28px, 6vw, 72px) clamp(20px, 5vw, 64px) clamp(40px, 7vw, 88px);
+  display: grid;
+  grid-template-columns: 1.05fr 0.95fr;
+  gap: clamp(28px, 5vw, 64px);
+  align-items: center;
+}
+.land-hero h1 {
+  font-size: clamp(32px, 4.6vw, 52px);
+  font-weight: 800;
+  letter-spacing: -0.02em;
+}
+.land-hero h1 em {
+  font-style: normal;
+  color: var(--leaf);
+}
+.land-hero .lead {
+  font-size: clamp(15px, 1.6vw, 17.5px);
+  color: var(--ink-soft);
+  max-width: 480px;
+  margin: 18px 0 26px;
+}
+.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
+
+.hero-scene { padding: 8px; }
+.hero-scene svg { display: block; width: 100%; height: auto; border-radius: 10px; }
+.hero-caption {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  justify-content: center;
+  margin-top: 16px;
+  font-size: 12.5px;
+  color: var(--ink-soft);
+}
+.scan-dot {
+  width: 8px; height: 8px;
+  border-radius: 999px;
+  background: var(--leaf-bright);
+  animation: pulse 1.8s infinite;
+}
+@keyframes pulse {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: 0.45; transform: scale(0.8); }
+}
+
+.land-section {
+  max-width: 1220px;
+  margin: 0 auto;
+  padding: clamp(36px, 5vw, 64px) clamp(20px, 5vw, 64px);
+}
+.land-section > h2 { font-size: clamp(24px, 3vw, 32px); max-width: 560px; }
+.land-section > .sec-lead { color: var(--ink-soft); max-width: 540px; margin: 12px 0 30px; }
+
+.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+.step { padding: 22px; }
+.step .n {
+  font-family: var(--font-display);
+  font-size: 15px;
+  font-weight: 800;
+  color: var(--leaf);
+  letter-spacing: 0.06em;
+}
+.step h3 { font-size: 17px; margin: 10px 0 8px; }
+.step p { font-size: 13.5px; color: var(--ink-soft); margin: 0; }
+
+.subj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+.subj { padding: 22px; }
+.subj .ic { margin-bottom: 12px; }
+.subj h3 { font-size: 17px; margin-bottom: 7px; }
+.subj p { font-size: 13.5px; color: var(--ink-soft); margin: 0; }
+
+.land-cta {
+  background: var(--leaf-deep);
+  color: #eaf3ec;
+  border-radius: 20px;
+  padding: clamp(32px, 5vw, 52px);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  flex-wrap: wrap;
+}
+.land-cta h2 { color: #fff; font-size: clamp(22px, 3vw, 30px); max-width: 460px; }
+.land-cta p { opacity: 0.85; margin: 8px 0 0; max-width: 440px; }
+.btn-ondark { background: #fff; color: var(--leaf-deep); }
+.btn-ondark:hover:not(:disabled) { background: var(--moss); }
+
+.land-footer {
+  max-width: 1220px;
+  margin: 0 auto;
+  padding: 26px clamp(20px, 5vw, 64px) 40px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  color: var(--ink-faint);
+  font-size: 13px;
+}
+
+@media (max-width: 860px) {
+  .land-hero { grid-template-columns: 1fr; }
+  .steps, .subj-grid { grid-template-columns: 1fr; }
+}
+
+/* ---------- Badge (nishon) kartalari ---------- */
+.badge-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  gap: 12px;
+}
+.badge-card {
+  padding: 15px;
+  text-align: center;
+  border-radius: var(--radius);
+  border: 1px solid var(--moss-line);
+  background: var(--surface);
+}
+.badge-card.locked { opacity: 0.5; filter: grayscale(0.7); }
+.badge-card .bic {
+  width: 44px; height: 44px;
+  border-radius: 999px;
+  margin: 0 auto 9px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--sun-soft);
+  color: var(--sun);
+}
+.badge-card h4 { font-size: 13.5px; }
+.badge-card p { font-size: 11.5px; color: var(--ink-faint); margin: 4px 0 0; }
+
+/* ---------- Dars ro'yxati ---------- */
+.lesson-row {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 15px 18px;
+  border-bottom: 1px solid #eef2ec;
+}
+.lesson-row:last-child { border-bottom: 0; }
+.lesson-check {
+  width: 30px; height: 30px;
+  border-radius: 999px;
+  border: 2px solid var(--moss-line);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: transparent;
+  flex-shrink: 0;
+}
+.lesson-check.done {
+  background: var(--leaf);
+  border-color: var(--leaf);
+  color: #fff;
+}
+.lesson-info { flex: 1; min-width: 0; }
+.lesson-title { font-weight: 600; font-size: 14.5px; }
+.lesson-sum { font-size: 12.5px; color: var(--ink-faint); }
+.xp-pill {
+  font-size: 12px;
+  font-weight: 700;
+  color: #9a6a1c;
+  background: var(--sun-soft);
+  border-radius: 999px;
+  padding: 3px 10px;
+  white-space: nowrap;
+}
+
+.embed-wrap {
+  border-radius: var(--radius-sm);
+  overflow: hidden;
+  background: #10201730;
+  aspect-ratio: 16 / 9;
+}
+.embed-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }
+
+/* ---------- Notification ---------- */
+.notif-row {
+  display: flex;
+  gap: 13px;
+  padding: 15px 18px;
+  border-bottom: 1px solid #eef2ec;
+  align-items: flex-start;
+}
+.notif-row:last-child { border-bottom: 0; }
+.notif-row.unread { background: #f2f7f0; }
+.notif-dot {
+  width: 9px; height: 9px;
+  border-radius: 999px;
+  background: var(--leaf-bright);
+  margin-top: 6px;
+  flex-shrink: 0;
+}
+.notif-row.read .notif-dot { background: var(--moss-line); }
+
+/* ---------- v2.1 qo'shimchalari ---------- */
+.avatar-img { object-fit: cover; }
+.nav-logout {
+  background: none;
+  border: 0;
+  cursor: pointer;
+  width: 100%;
+  text-align: left;
+  font-family: inherit;
+  margin-top: 4px;
+}
+.avatar-lg {
+  width: 74px; height: 74px;
+  font-size: 28px;
+  border-radius: 999px;
+}
+.upload-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.file-hint { font-size: 12.5px; color: var(--ink-faint); }
+.lesson-content {
+  background: var(--paper);
+  border: 1px solid var(--moss-line);
+  border-radius: var(--radius-sm);
+  padding: 16px 18px;
+  font-size: 14.5px;
+  white-space: pre-wrap;
+  margin-bottom: 14px;
+  max-height: 380px;
+  overflow-y: auto;
+}
+model-viewer {
+  width: 100%;
+  height: 100%;
+  --poster-color: transparent;
+}
+.rank-num {
+  font-family: var(--font-display);
+  font-weight: 800;
+  color: var(--ink-faint);
+  width: 30px;
+  display: inline-block;
+}
+
+/* ---------- Skeleton yuklanish (sahifa "qotib qolgandek" tuyulmasligi uchun) ---------- */
+.sk {
+  background: linear-gradient(90deg, #e8eee6 25%, #f2f6f0 50%, #e8eee6 75%);
+  background-size: 200% 100%;
+  border-radius: 8px;
+  animation: skshine 1.3s ease-in-out infinite;
+}
+@keyframes skshine {
+  from { background-position: 200% 0; }
+  to { background-position: -200% 0; }
+}
+.sk-line { height: 13px; margin-bottom: 9px; }
+.sk-title { height: 26px; width: 220px; margin-bottom: 10px; }
+.sk-card { height: 128px; }
+
+/* ---------- Maktab o'quvchilari uchun kattaroq bosish maydonlari ---------- */
+@media (max-width: 920px) {
+  .btn { padding: 12px 20px; font-size: 15px; }
+  .btn-sm { padding: 9px 16px; font-size: 14px; }
+  .iconbtn { width: 40px; height: 40px; }
+  .nav-link { padding: 13px 14px; font-size: 15px; }
+  .lesson-row { flex-wrap: wrap; gap: 10px; }
+  .lesson-info { flex-basis: 100%; order: -1; }
+  .input, .select, .textarea { font-size: 16px; } /* iOS zoom oldini oladi */
+}
+
+/* ---------- Parol maydoni (ko'rsatish/yashirish) ---------- */
+.pw-wrap { position: relative; display: flex; }
+.pw-input { padding-right: 46px; }
+.pw-toggle {
+  position: absolute;
+  right: 6px;
+  top: 50%;
+  transform: translateY(-50%);
+  width: 34px; height: 34px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 0;
+  background: transparent;
+  color: var(--ink-faint);
+  border-radius: 8px;
+  cursor: pointer;
+}
+.pw-toggle:hover { color: var(--ink); background: var(--moss); }
+
+/* ---------- Dars tartibini almashtirish tugmalari ---------- */
+.order-btn {
+  border: 1px solid var(--moss-line);
+  background: var(--surface);
+  color: var(--ink-soft);
+  border-radius: 5px;
+  width: 22px;
+  height: 15px;
+  font-size: 8px;
+  line-height: 1;
+  cursor: pointer;
+  padding: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+}
+.order-btn:hover:not(:disabled) { background: var(--moss); color: var(--leaf-deep); }
+.order-btn:disabled { opacity: 0.35; cursor: not-allowed; }
+
+/* ---------- Qulaylik (accessibility) ---------- */
+
+/* Faqat ekran o'quvchilar uchun matn */
+.visually-hidden {
+  position: absolute !important;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* Menyuni o'tkazib yuborish havolasi */
+.skip-link {
+  position: absolute;
+  top: -100px;
+  left: 12px;
+  z-index: 200;
+  background: var(--leaf-deep);
+  color: #fff;
+  padding: 12px 20px;
+  border-radius: 0 0 10px 10px;
+  font-weight: 600;
+  text-decoration: none;
+  transition: top 0.15s;
+}
+.skip-link:focus {
+  top: 0;
+}
+
+/* Kontrastni oshirish: kulrang matnlar WCAG AA talabiga moslashtirildi */
+:root {
+  --ink-soft: #46594e;
+  --ink-faint: #63786c;
+}
+
+/* Bosish maydonlari kamida 44px (WCAG 2.5.8) */
+.iconbtn { min-width: 36px; min-height: 36px; }
+.order-btn { min-height: 16px; }
+
+/* Fokus ko'rinishi barcha interaktiv elementlarda */
+a:focus-visible,
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible,
+[tabindex]:focus-visible {
+  outline: 3px solid var(--leaf);
+  outline-offset: 2px;
+}
+
+/* Modal ichidagi fokus halqasi oq fonda ham ko'rinsin */
+.modal :focus-visible { outline-color: var(--leaf-deep); }
+
+/* ---------- Landing: inline uslublar CSS'ga ko'chirildi ---------- */
+.land-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  text-decoration: none;
+  color: inherit;
+}
+.brand-mark-leaf { background: var(--leaf); color: #fff; }
+
+.hero-figure { margin: 0; }
+
+.subj-ic {
+  width: 38px;
+  height: 38px;
+  border-radius: 11px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 12px;
+}
+.subj-ic-green { background: var(--moss); color: var(--leaf-deep); }
+.subj-ic-sun { background: var(--sun-soft); color: #8a5f18; }
+.subj-ic-sky { background: var(--sky-soft); color: #2b5c7d; }
+
+/* Landing ro'yxatlari (ol/ul) — belgilarsiz */
+.steps, .subj-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.land-footer nav a { color: inherit; }
+.land-footer p { margin: 0; }
