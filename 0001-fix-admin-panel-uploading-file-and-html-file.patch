+            {form.modelUrl ? (
+              <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
+                <span className="chip chip-amber">Model yuklandi</span>
+                <a href={form.modelUrl} target="_blank" rel="noopener noreferrer" className="btn btn-ghost btn-sm">
+                  Tekshirish
+                </a>
